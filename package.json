{
  "name": "@bugs5382/node-oxlint-config",
  "version": "0.8.0",
  "description": "Shared Oxlint and oxfmt configs for Bugs5382 projects: the house lint rules and Prettier-compatible formatting.",
  "keywords": [
    "oxlint",
    "oxlint-config",
    "oxfmt",
    "lint",
    "format"
  ],
  "homepage": "https://github.com/Bugs5382/node-oxlint-config#readme",
  "bugs": {
    "url": "https://github.com/Bugs5382/node-oxlint-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bugs5382/node-oxlint-config.git"
  },
  "license": "MIT",
  "author": "Shane A. Froebel",
  "type": "module",
  "exports": {
    "./oxfmt": {
      "types": "./configs/oxfmt.d.mts",
      "default": "./configs/oxfmt.mjs"
    },
    "./configs/*": "./configs/*",
    "./package.json": "./package.json"
  },
  "files": [
    "configs/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:npm": "npmPkgJsonLint .",
    "lint:package": "npx sort-package-json",
    "pack": "npm pack",
    "test": "vitest run",
    "test:watch": "vitest",
    "update": "npx npm-check-updates -u --peer && npm install --legacy-peer-deps --ignore-scripts"
  },
  "dependencies": {
    "eslint": "10.14.0",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-storybook": "10.6.5",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-typedoc": "1.3.6",
    "eslint-plugin-unicorn": "65.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.0.1",
    "npm": "^11.18.0",
    "npm-package-json-lint": "^10.4.1",
    "npm-package-json-lint-config-default": "^9.0.1",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "sort-package-json": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": ">=7.0.2005"
  },
  "peerDependenciesMeta": {
    "oxfmt": {
      "optional": true
    }
  },
  "packageManager": "npm@11.18.0",
  "publishConfig": {
    "access": "public"
  }
}
